---
import { Button } from "@bjelle/ui";
import Layout from "../layouts/Layout.astro";

const signaler = [
	{
		merke: "Viktig",
		klasse: "bg-signal-viktig-flate text-signal-viktig",
		tekst: "Emisjon: selskapet trykker nye aksjer, og din andel vannes ut litt.",
	},
	{
		merke: "Greit å vite",
		klasse: "bg-signal-greit-flate text-signal-greit",
		tekst: "Innsidehandel: en i ledelsen har kjøpt aksjer i eget selskap.",
	},
	{
		merke: "Støy",
		klasse: "bg-signal-stoy-flate text-signal-stoy",
		tekst: "Endring i finansiell kalender. Trenger du ikke gjøre noe med.",
	},
];
---

<Layout
	title="Bjelle - børsmeldinger i klarspråk"
	description="Bjelle følger med på Oslo Børs for deg og forklarer hver melding på norsk du faktisk forstår."
>
	<main class="mx-auto max-w-3xl px-6 py-24">
		<p class="font-medium text-bjelle-700 text-sm uppercase tracking-widest">Bjelle</p>
		<h1 class="mt-4 text-balance font-bold text-5xl text-ink-950 leading-tight">
			Børsmeldinger, forklart som om du var ny.
		</h1>
		<p class="mt-6 text-ink-600 text-xl">
			Vi følger med på selskapene du eier og sier ifra når noe faktisk betyr noe for deg.
			Ingen forkortelser uten forklaring.
		</p>

		<div class="mt-10 flex flex-wrap gap-3">
			<Button size="lg" client:load>Få gratis nyhetsbrev</Button>
			<Button size="lg" variant="ghost" client:load>Se hvordan det virker</Button>
		</div>

		<ul class="mt-16 space-y-4">
			{
				signaler.map((signal) => (
					<li class="flex gap-4 rounded-card border border-ink-200 bg-white p-5">
						<span
							class:list={[
								"h-fit rounded-pill px-3 py-1 font-medium text-xs whitespace-nowrap",
								signal.klasse,
							]}
						>
							{signal.merke}
						</span>
						<p class="text-ink-700">{signal.tekst}</p>
					</li>
				))
			}
		</ul>
	</main>
</Layout>
