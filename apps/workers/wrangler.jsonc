{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bjelle-workers",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"triggers": {
		// Newsweb-polling. Fem minutter er innenfor "varsler innen minutter"-løftet
		// i konseptet, uten å hamre kilden.
		//
		// Backfill og selskapssynk går sjeldnere. Cronen skiller dem på uttrykket,
		// se scheduled-handleren.
		"crons": ["*/5 * * * *", "7,22,37,52 * * * *", "23 4 * * *"]
	},
	"secrets": {
		// Kun navnet. Verdien settes med `wrangler secret put ANTHROPIC_API_KEY`
		// og finnes aldri i repoet. Dette gir Env-typen og en advarsel i dev
		// hvis hemmeligheten mangler.
		"required": ["ANTHROPIC_API_KEY", "OPERATOR_TOKEN"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bjelle",
			// PLASSHOLDER. Byttes med ekte id fra `wrangler d1 create bjelle`
			// på Bjelle-kontoen, med EU-hint. Miniflare bryr seg ikke om verdien.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			// Rålageret. Kildens payload og vedlegg skrives hit før noe parses,
			// slik at parsingen alltid kan kjøres om, også med en ny parser.
			"binding": "RAW",
			"bucket_name": "bjelle-raw"
		}
	],
	"queues": {
		"producers": [
			{
				"queue": "bjelle-enrichment",
				"binding": "ENRICHMENT"
			}
		],
		"consumers": [
			{
				"queue": "bjelle-enrichment",
				// Små batcher: hver melding er ett språkmodellkall, og en batch
				// som ikke rekker å bli ferdig blir levert om igjen i sin helhet.
				"max_batch_size": 5,
				"max_batch_timeout": 30,
				// Køens eget tak er én høyere enn vårt. Vi teller forsøk i D1 og
				// setter dead_letter selv på tredje feil, slik at "tre forsøk brukt
				// opp" er observerbart. Dette taket fanger bare krasj og timeout.
				"max_retries": 3,
				"dead_letter_queue": "bjelle-enrichment-dlq"
			},
			{
				// Dødbrevkøen konsumeres av samme worker. Den skriver tilstanden
				// dead_letter og gjør ikke annet: en giftig melding skal stoppe her.
				"queue": "bjelle-enrichment-dlq",
				"max_batch_size": 10,
				"max_retries": 0
			}
		]
	}
}
